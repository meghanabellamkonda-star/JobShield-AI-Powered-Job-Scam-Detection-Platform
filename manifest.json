{
  "manifest_version": 3,
  "name": "JobShield - Scam Job Detector Companion",
  "short_name": "JobShield",
  "version": "2.0.0",
  "description": "Launch the JobShield web application to analyze job listings and detect employment scams",
  "permissions": [
    "activeTab",
    "tabs",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Analyze on JobShield Website",
    "default_icon": {
      "16": "rfman.png",
      "32": "rfman.png",
      "48": "rfman.png",
      "128": "rfman.png"
    }
  },
  "icons": {
    "16": "rfman.png",
    "32": "rfman.png",
    "48": "rfman.png",
    "128": "rfman.png"
  }
}